{
  "rules": [
    {
      "rule_id": "DNS_STAT_001",
      "rule_name": "域名字段空值率异常",
      "category": "dns_log",
      "scope": {"source_id": "", "fields": ["domain"]},
      "dimension": "completeness",
      "rule_type": "statistical",
      "operator": "compare_metric",
      "params": {"metric": "field_null_rate", "field": "domain", "threshold": 0.2, "comparison": "gt"},
      "severity": "high",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "DNS_STAT_002",
      "rule_name": "数据量相对基线下降",
      "category": "dns_log",
      "scope": {"source_id": "", "fields": []},
      "dimension": "timeliness",
      "rule_type": "statistical",
      "operator": "compare_baseline",
      "params": {"metric": "volume", "ratio_lt": 0.5},
      "severity": "high",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "DNS_STAT_003",
      "rule_name": "数据量相对基线上升",
      "category": "dns_log",
      "scope": {"source_id": "", "fields": []},
      "dimension": "timeliness",
      "rule_type": "statistical",
      "operator": "compare_baseline",
      "params": {"metric": "volume", "ratio_gt": 2},
      "severity": "medium",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "DNS_STAT_004",
      "rule_name": "查询类型分布漂移",
      "category": "dns_log",
      "scope": {"source_id": "", "fields": ["dns_query_type"]},
      "dimension": "validity",
      "rule_type": "statistical",
      "operator": "compare_distribution",
      "params": {"field": "dns_query_type", "max_delta": 0.4},
      "severity": "medium",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "DNS_STAT_005",
      "rule_name": "响应码分布漂移",
      "category": "dns_log",
      "scope": {"source_id": "", "fields": ["dns_res_code"]},
      "dimension": "validity",
      "rule_type": "statistical",
      "operator": "compare_distribution",
      "params": {"field": "dns_res_code", "max_delta": 0.4},
      "severity": "medium",
      "enabled": true,
      "version": "1.0.0"
    }
  ]
}
