{
  "rules": [
    {"rule_id": "FLOW_FIELD_001", "rule_name": "源IP空值率", "category": "flow_log", "scope": {"source_id": "", "fields": ["src_ip"]}, "dimension": "completeness", "rule_type": "deterministic", "operator": "field_empty", "params": {"field": "src_ip", "alert_rate": 0}, "severity": "high", "enabled": true, "version": "1.0.0", "description": "源IP出现空值即告警"},
    {"rule_id": "FLOW_FIELD_002", "rule_name": "目的IP空值率", "category": "flow_log", "scope": {"source_id": "", "fields": ["dst_ip"]}, "dimension": "completeness", "rule_type": "deterministic", "operator": "field_empty", "params": {"field": "dst_ip", "alert_rate": 1.1}, "severity": "high", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_003", "rule_name": "接收时间空值率", "category": "flow_log", "scope": {"source_id": "", "fields": ["recv_time"]}, "dimension": "completeness", "rule_type": "deterministic", "operator": "field_empty", "params": {"field": "recv_time", "alert_rate": 1.1}, "severity": "high", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_010", "rule_name": "源IP格式有效性", "category": "flow_log", "scope": {"source_id": "", "fields": ["src_ip"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_ip", "params": {"field": "src_ip", "allowed_formats": ["ipv4", "ipv6"], "alert_rate": 0}, "severity": "high", "enabled": true, "version": "1.0.0", "description": "规范表要求点分 IPv4 或完整 IPv6，出现非法值即告警"},
    {"rule_id": "FLOW_FIELD_011", "rule_name": "目的IP格式有效性", "category": "flow_log", "scope": {"source_id": "", "fields": ["dst_ip"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_ip", "params": {"field": "dst_ip", "allowed_formats": ["ipv4", "ipv6"], "alert_rate": 0.05}, "severity": "high", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_012", "rule_name": "下一跳IP格式有效性", "category": "flow_log", "scope": {"source_id": "", "fields": ["next_hop_ip"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_ip", "params": {"field": "next_hop_ip", "allowed_formats": ["ipv4"], "alert_rate": 0.05}, "severity": "medium", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_014", "rule_name": "接收时间格式有效性", "category": "flow_log", "scope": {"source_id": "", "fields": ["recv_time"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_time", "params": {"field": "recv_time", "formats": ["iso8601"], "alert_rate": 0.05}, "severity": "high", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_020", "rule_name": "源端口范围", "category": "flow_log", "scope": {"source_id": "", "fields": ["src_port"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_number", "params": {"field": "src_port", "integer": true, "min": 0, "max": 65535, "alert_rate": 0.05}, "severity": "medium", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_021", "rule_name": "目的端口范围", "category": "flow_log", "scope": {"source_id": "", "fields": ["dst_port"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_number", "params": {"field": "dst_port", "integer": true, "min": 0, "max": 65535, "alert_rate": 0.05}, "severity": "medium", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_040", "rule_name": "会话包数数值", "category": "flow_log", "scope": {"source_id": "", "fields": ["session_total_pkts"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_number", "params": {"field": "session_total_pkts", "integer": true, "min": 0, "alert_rate": 0.05}, "severity": "low", "enabled": true, "version": "1.0.0"},
    {"rule_id": "FLOW_FIELD_041", "rule_name": "会话字节数数值", "category": "flow_log", "scope": {"source_id": "", "fields": ["session_total_bytes"]}, "dimension": "validity", "rule_type": "deterministic", "operator": "validate_number", "params": {"field": "session_total_bytes", "integer": true, "min": 0, "alert_rate": 0.05}, "severity": "low", "enabled": true, "version": "1.0.0"}
  ]
}
