{
  "rules": [
    {
      "rule_id": "FLOW_RECORD_001",
      "rule_name": "核心字段组合完整性",
      "category": "flow_log",
      "scope": {"source_id": "", "fields": ["recv_time", "src_ip", "dst_ip"]},
      "dimension": "completeness",
      "rule_type": "deterministic",
      "operator": "record_required",
      "params": {"all_of": ["recv_time"], "any_of": ["src_ip", "dst_ip"], "alert_rate": 0.05},
      "severity": "high",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "FLOW_RECORD_002",
      "rule_name": "疑似重复记录",
      "category": "flow_log",
      "scope": {"source_id": "", "fields": []},
      "dimension": "uniqueness",
      "rule_type": "deterministic",
      "operator": "record_fingerprint",
      "params": {"fields_from_profile": "duplicate_fields", "alert_rate": 2},
      "severity": "info",
      "enabled": true,
      "version": "1.0.0"
    },
    {
      "rule_id": "FLOW_RECORD_004",
      "rule_name": "未来时间记录",
      "category": "flow_log",
      "scope": {"source_id": "", "fields": ["recv_time"]},
      "dimension": "timeliness",
      "rule_type": "deterministic",
      "operator": "future_time",
      "params": {"field": "recv_time", "formats": ["iso8601"], "slack_hours": 24, "alert_rate": 0.01},
      "severity": "medium",
      "enabled": true,
      "version": "1.0.0"
    }
  ]
}
