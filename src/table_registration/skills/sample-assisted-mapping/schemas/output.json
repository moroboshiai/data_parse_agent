{
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_field", "target_field", "explanation", "confidence", "evidence", "reason", "needs_human_confirm"],
        "properties": {
          "source_field": { "type": "string" },
          "target_field": { "type": ["string", "null"] },
          "explanation": { "type": "string" },
          "confidence": { "type": ["string", "null"] },
          "confidence_score": { "type": ["number", "null"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "needs_human_confirm": { "type": "boolean" }
        }
      }
    }
  }
}
